# Copy to .env.local and fill in. The app boots without these (UI shell only);
# they're required to wire auth, storage, and billing.

# --- Supabase (create a project at supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (apply WEEK 0 — India onboarding is slow) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
# Invites send via Resend when this is set; without it, the invite UI still
# surfaces a copyable accept link so the flow works locally.
RESEND_API_KEY=
# Optional verified sender. Defaults to Resend's sandbox (onboarding@resend.dev),
# which only delivers to your own account email until you verify a domain.
INVITE_EMAIL_FROM=

# --- Analytics / errors (optional for first boot) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
