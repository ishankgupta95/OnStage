# Copy to .env.local and fill in. The app is fully client-side (no backend) and
# ships as a free, no-account tool — every var here is optional; the app boots
# and runs without any of them.

# --- Feature flags (src/lib/features.ts) ---
# The account-shaped surfaces are built and gated, not deleted. Each is OFF
# unless its var is exactly the string "true". NEXT_PUBLIC_* is inlined at
# build time, so flipping one means a rebuild (and setting it in
# .github/workflows/deploy.yml for the Pages deploy).
#
#   accounts    — /signin, /auth/callback, the account chrome, Settings →
#                 Account identity + Notifications
#   teams       — /review, Settings → Team, collaborator chrome
#   billing     — /pricing, Settings → Plan & billing, the plan tables
#   exportQuota — the 5-export allowance and the metering that feeds it
#
# Fixture-only surfaces — they show invented data or can never succeed without
# a server, so they stay off until a backend exists:
#
#   storeUpload  — store destinations in the export dialog, Settings → Store
#                  connections, Reconnect, "Push live"
#   aiAssist     — the AI caption / localise drawer
#   abTest       — /ab-test and the project board's variant cards
#   jobQueue     — /queue, the project board's Uploads tab and Activity feed
#   storeImport  — importing a listing from an App Store / Play URL
#   designBoards — the design-review boards /states and /mobile
#
# NEXT_PUBLIC_FEATURE_ACCOUNTS=true
# NEXT_PUBLIC_FEATURE_TEAMS=true
# NEXT_PUBLIC_FEATURE_BILLING=true
# NEXT_PUBLIC_FEATURE_EXPORT_QUOTA=true
# NEXT_PUBLIC_FEATURE_STORE_UPLOAD=true
# NEXT_PUBLIC_FEATURE_AI_ASSIST=true
# NEXT_PUBLIC_FEATURE_AB_TEST=true
# NEXT_PUBLIC_FEATURE_JOB_QUEUE=true
# NEXT_PUBLIC_FEATURE_STORE_IMPORT=true
# NEXT_PUBLIC_FEATURE_DESIGN_BOARDS=true

# --- Legal (Termly) ---
# Set after you create the policies in Termly. The /privacy and /terms routes
# fall back to placeholder copy when these are unset.
NEXT_PUBLIC_TERMLY_WEBSITE_UUID=
NEXT_PUBLIC_TERMLY_PRIVACY_UUID=
NEXT_PUBLIC_TERMLY_TERMS_UUID=

# --- Site ---
# Canonical origin used by sitemap.ts, robots.ts, and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Static export (GitHub Pages) ---
# Only the Pages CI build sets these (see .github/workflows/deploy.yml): they
# turn on Next's static `output: export` + the /OnStage basePath. Leave unset
# for normal local dev and builds.
# NEXT_PUBLIC_STATIC_EXPORT=true
# NEXT_PUBLIC_BASE_PATH=/OnStage
