# Copy to .env.local and fill in. The app boots without these (UI shell only);
# they're required to wire auth, storage, and billing.

# --- Supabase (create a project at supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (apply WEEK 0 — India onboarding is slow) ---
# The app boots without these. With them set, /pricing CTAs and /settings/billing
# start real Checkout / Customer Portal sessions; without them, both surface
# "Coming soon" / "Billing not configured" stubs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs from your Stripe products. Create two products in Stripe (Solo,
# Team) and copy the price IDs here. Without these, the matching plans render
# as "Coming soon".
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_TEAM=

# --- Legal (Termly) ---
# Set after you create the policies in Termly. The /privacy and /terms routes
# fall back to placeholder copy when these are unset.
NEXT_PUBLIC_TERMLY_WEBSITE_UUID=
NEXT_PUBLIC_TERMLY_PRIVACY_UUID=
NEXT_PUBLIC_TERMLY_TERMS_UUID=

# --- Email (Resend) ---
# Invites send via Resend when this is set; without it, the invite UI still
# surfaces a copyable accept link so the flow works locally.
RESEND_API_KEY=
# Optional verified sender. Defaults to Resend's sandbox (onboarding@resend.dev),
# which only delivers to your own account email until you verify a domain.
INVITE_EMAIL_FROM=

# --- Analytics / errors (optional for first boot) ---
# PostHog (funnel events). Without the key, analytics is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry. SENTRY_DSN powers server-side capture (instrumentation.ts);
# NEXT_PUBLIC_SENTRY_DSN powers client-side capture (instrumentation-client.ts).
# A Sentry DSN is safe to expose publicly; both are usually the same project DSN.
# Source-map upload (readable stack traces) needs withSentryConfig + a Sentry
# auth token — deferred until launch; runtime error capture works without it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used by sitemap.ts, OG image URLs, and Stripe success/cancel redirects.
# Should be the canonical production origin once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
