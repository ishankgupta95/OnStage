{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "onstage",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "onstage-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "-d",
        "/tmp/onstage-pages"
      ],
      "port": 4173
    }
  ]
}
